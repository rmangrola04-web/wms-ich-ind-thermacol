  "firestore": {
    "/ich_operations/{operationId}": {
      "schema": "Operation",
      "description": "Active warehouse loading and unloading operations"
    },
    "/ich_security_logs/{logId}": {
      "schema": "SecurityGateEntry",
      "description": "Security gate entry and exit movement records"
    },
    "/ich_plan_entries/{planId}": {
      "schema": "PlanEntry",
      "description": "Daily planned warehouse dispatches"
    },
    "/ich_archived_plan_entries/{archivedId}": {
      "schema": "PlanEntry",
      "description": "Archived planning entries for historical tracking"
    },
    "/ich_tracking_records/{recordId}": {
      "schema": "TrackingRecord",
      "description": "In-transit vehicle tracking updates"
    },
    "/ich_users/{userId}": {
      "schema": "UserAccount",
      "description": "Internal warehouse operator and supervisor accounts"
    },
    "/ich_master_transporters/{transporterId}": {
      "schema": "MasterItem",
      "description": "Approved logistics transporters master"
    },
    "/ich_master_vehicle_types/{vehicleTypeId}": {
      "schema": "MasterItem",
      "description": "Standard truck and vehicle types master"
    },
    "/ich_master_load_locations/{locationId}": {
      "schema": "MasterItem",
      "description": "Warehouse loading bays and source locations"
    },
    "/ich_master_unload_locations/{locationId}": {
      "schema": "MasterItem",
      "description": "Warehouse receiving bays and destination locations"
    },
    "/ich_master_supervisors/{supervisorId}": {
      "schema": "MasterItem",
      "description": "Registered warehouse floor supervisors"
    },
    "/ich_th_inwards/{inwardId}": {
      "schema": "ThermocolInward",
      "description": "Packing material inward stock lots and live stock balances"
    },
    "/ich_th_invoices/{invoiceId}": {
      "schema": "ThermocolInvoice",
      "description": "Packing material outward delivery challans and invoices"
    },
    "/ich_th_products/{productId}": {
      "schema": "MasterItem",
      "description": "Packing material product master records"
    },
    "/ich_th_parties/{partyId}": {
      "schema": "MasterItem",
      "description": "Packing material client/party master records"
    },
    "/ich_th_transporters/{transporterId}": {
      "schema": "MasterItem",
      "description": "Packing material transporter records"
    },
    "/ich_th_demands/{demandId}": {
      "schema": "MasterItem",
      "description": "Packing material client demand quotas"
    },
    "/ich_th_audits/{auditId}": {
      "schema": "InvoiceAuditLog",
      "description": "Invoice modification, generation, and cancellation audit logs"
    },
    "/ich_th_sequences/{sequenceId}": {
